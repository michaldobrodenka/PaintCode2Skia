<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WindowsForms only ships a net10.0-windows10.0.19041 asset; a plain
         net10.0-windows (= windows7.0) target silently falls back to the net462 build. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PaintCodeResources.Sample.WinForms</RootNamespace>
    <AssemblyName>PaintCodeResources.Sample.WinForms</AssemblyName>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework leftovers: the SDK generates the assembly info, and the sample uses
         neither Properties.Resources nor Properties.Settings. -->
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaintCodeResources\PaintCodeResources.csproj" />
  </ItemGroup>

</Project>
